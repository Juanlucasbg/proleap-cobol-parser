# SaleADS login page URL for the target environment.
# Keep this environment-agnostic: set it per run (dev/staging/prod).
SALEADS_LOGIN_URL=https://your-saleads-environment/login

# Optional override if your login route differs.
# SALEADS_BASE_URL=https://your-saleads-environment

# Optional: set "false" to run in headed mode.
# PW_HEADLESS=true
